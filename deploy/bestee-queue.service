# systemd unit for the Celery worker (the tuning queue).
# Install to /etc/systemd/system/bestee-queue.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now bestee-queue
# Logs: journalctl -u bestee-queue -f   (stdout)  and  /var/log/bestee/queue.log
#
# Adjust User, paths, and --concurrency to your droplet. Secrets are read from
# the repo-root .env by the app itself (python-dotenv walks up from the
# WorkingDirectory); only LOG_DIR is set here so files land in /var/log/bestee.

[Unit]
Description=bestee Celery worker (tuning queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bestee
Group=bestee
WorkingDirectory=/opt/bestee/queue
Environment=LOG_DIR=/var/log/bestee
Environment=LOG_LEVEL=INFO
Environment=LOG_FORMAT=json
ExecStart=/opt/bestee/queue/.venv/bin/celery -A main worker --loglevel=INFO --concurrency=2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
