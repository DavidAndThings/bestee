# Copy to .env.local and fill in. Vite only exposes vars prefixed with VITE_.

# Clerk publishable key (required). Clerk dashboard -> API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the bestee API. Leave UNSET to use the in-browser mock backend.
# For local dev against `make dev`, use the Vite proxy (recommended): it keeps
# the browser same-origin (no CORS) and avoids the localhost IPv4/IPv6 mismatch.
# VITE_API_BASE_URL=/api
#
# Or point directly at a running API. Use 127.0.0.1 (not localhost) so the
# browser doesn't resolve to IPv6 ::1 while uvicorn listens on IPv4:
# VITE_API_BASE_URL=http://127.0.0.1:8000
